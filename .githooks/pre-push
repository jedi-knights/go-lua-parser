#!/usr/bin/env bash
# pre-push hook: run the same lint checks CI runs (go vet + golangci-lint)
# before pushing to any remote.
# Install: git config core.hooksPath .githooks

set -euo pipefail

if ! command -v golangci-lint &>/dev/null; then
  echo "pre-push: golangci-lint not found — skipping lint check" >&2
  echo "  Install: https://golangci-lint.run/welcome/install/" >&2
  exit 0
fi

echo "pre-push: running make lint (go vet + golangci-lint)..." >&2
make lint
